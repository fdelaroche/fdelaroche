meta {
  name: memory-leak
  type: http
  seq: 4
}

post {
  url: {{host}}/trigger/memory-leak
  body: json
  auth: inherit
}

body:json {
  {
    "duration": 10000,
    "intensity": 4
  }
}

tests {
  test("status should be 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("content-type should be json", function() {
    expect(res.getHeader("content-type")).to.contain("application/json");
  });
  
}

settings {
  encodeUrl: true
  timeout: 0
}
